<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ 的云备份与设备迁移规则：同样排除密钥存储文件 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="secure_key_store.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="secure_key_store.xml" />
    </device-transfer>
</data-extraction-rules>
