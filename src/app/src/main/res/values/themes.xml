<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 状态栏跟随表面色，视觉上让官方页面“占满”屏幕；正文排版完全由上游页面控制 -->
    <style name="Theme.DeepSeekAssistant" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="android:statusBarColor">@color/screen_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/screen_background</item>
        <item name="android:colorBackground">@color/screen_background</item>
    </style>
</resources>
